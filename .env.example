# Скопируйте файл в .env и поменяйте значения перед запуском.
# docker compose читает .env автоматически.

# --- Postgres ---
POSTGRES_DB=roe
POSTGRES_USER=roe
POSTGRES_PASSWORD=change_me_postgres
# Порт, на котором Postgres будет доступен с хоста.
POSTGRES_PORT=5432

# --- Админка ---
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me_admin
# Секрет для подписи токенов сессии. Сгенерировать: openssl rand -hex 32
SESSION_SECRET=change_me_session_secret
SESSION_TTL_HOURS=12

# --- Порты приложения ---
# Дашборд и админка (nginx).
WEB_PORT=8080
# API наружу не публикуется, значение используется внутри сети compose.
API_PORT=3000

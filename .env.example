# Скопируйте файл в .env и поменяйте значения перед запуском.
# docker compose читает .env автоматически.

# --- Postgres ---
POSTGRES_DB=roe
POSTGRES_USER=roe
POSTGRES_PASSWORD=change_me_postgres
# Порт, на котором Postgres будет доступен с хоста.
POSTGRES_PORT=5432

# --- Админка ---
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me_admin
# Секрет для подписи токенов сессии. Сгенерировать: openssl rand -hex 32
SESSION_SECRET=change_me_session_secret
SESSION_TTL_HOURS=12

# --- Порты приложения ---
# Дашборд и админка (nginx).
WEB_PORT=8080
# API наружу не публикуется, значение используется внутри сети compose.
API_PORT=3000

# --- Строка подключения API к Postgres (внутри compose-сети host=db) ---
DATABASE_URL=postgres://roe:change_me_postgres@db:5432/roe

# --- Telegram user-сессия (https://my.telegram.org) ---
TG_API_ID=123456
TG_API_HASH=replace_me_telegram_api_hash
# HTTP CONNECT к telegram-proxy (setup.sh, :3128). Нужен ACL на DC Telegram
# (api.telegram.org + CIDR AS Telegram на 443) — иначе Telethon получит 403.
#   http://tg-proxy:pass@telegram-proxy.messengers.aheron.pro:3128
# Алиасы: TG_PROXY, TELEGRAM_HTTP_PROXY.
TELEGRAM_PROXY=

# --- OpenRouter ---
OPENROUTER_API_KEY=replace_me_openrouter_key
# GPT-5.6 Luna + reasoning.effort=max в коде воркера.
OPENROUTER_MODEL=openai/gpt-5.6-luna
# HTTP-прокси только для запросов к OpenRouter (если api режется с стенда).
# OPENROUTER_PROXY_URL=http://user:pass@host:port
OPENROUTER_PROXY_URL=
TG_SYNC_POLL_SECONDS=20
TG_SYNC_HTTP_PORT=3010
